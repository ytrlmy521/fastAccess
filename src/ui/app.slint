import { ScrollView } from "std-widgets.slint";

export struct UiRecentItem {
    name: string,
    path: string,
    accessed: string,
    kind: string,
}

export component AppWindow inherits Window {
    title: "FastAccess";
    icon: @image-url("icons/app.svg");
    always-on-top: true;
    min-width: 720px;
    min-height: 520px;
    background: #11151d;

    in-out property <string> query;
    in property <[UiRecentItem]> results;
    in-out property <int> selected-index: results.length > 0 ? 0 : -1;
    in property <string> status-text: "Loading recent items…";

    callback search-changed(string);
    callback open-requested(int);
    callback dismiss-requested();
    callback quit-requested();

    forward-focus: keyboard-scope;

    keyboard-scope := FocusScope {
        forward-focus: search-input;

        capture-key-pressed(event) => {
            if event.text == Key.DownArrow {
                if root.results.length > 0 {
                    root.selected-index = min(root.selected-index + 1, root.results.length - 1);
                }
                accept
            } else if event.text == Key.UpArrow {
                if root.results.length > 0 {
                    root.selected-index = max(root.selected-index - 1, 0);
                }
                accept
            } else if event.text == Key.Return {
                if root.selected-index >= 0 {
                    root.open-requested(root.selected-index);
                }
                accept
            } else if event.text == Key.Escape {
                root.dismiss-requested();
                accept
            } else {
                reject
            }
        }

        KeyBinding {
            keys: @keys(Control + Q);
            activated => { root.quit-requested(); }
        }

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            Rectangle {
                height: 52px;
                border-radius: 10px;
                background: #1b2230;
                border-width: 1px;
                border-color: search-input.has-focus ? #5b8cff : #303a4b;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 11px;

                    Image {
                        width: 20px;
                        height: 20px;
                        source: @image-url("icons/search.svg");
                        colorize: #8ea7d8;
                    }

                    input-viewport := Rectangle {
                        horizontal-stretch: 1;
                        clip: true;

                        search-input := TextInput {
                            width: max(parent.width, self.preferred-width);
                            height: parent.height;
                            text <=> root.query;
                            color: #edf3ff;
                            selection-foreground-color: #ffffff;
                            selection-background-color: #446fca;
                            font-size: 14px;
                            font-family: "Microsoft YaHei UI, Segoe UI, sans-serif";
                            vertical-alignment: center;
                            input-type: search;
                            accessible-placeholder-text: "Search Windows Recent";
                            edited() => {
                                root.selected-index = root.results.length > 0 ? 0 : -1;
                                root.search-changed(self.text);
                            }
                            accepted() => {
                                if root.selected-index >= 0 {
                                    root.open-requested(root.selected-index);
                                }
                            }
                            cursor-position-changed(cursor-position) => {
                                if cursor-position.x + self.x < 2px {
                                    self.x = -cursor-position.x + 2px;
                                } else if cursor-position.x + self.x > parent.width - 4px - self.text-cursor-width {
                                    self.x = parent.width - cursor-position.x - 4px - self.text-cursor-width;
                                }
                            }
                        }

                        if root.query == "": Text {
                            text: "Search Windows Recent…";
                            color: #7f8da3;
                            font-size: 14px;
                            font-family: "Microsoft YaHei UI, Segoe UI, sans-serif";
                            vertical-alignment: center;
                        }
                    }
                }
            }

            HorizontalLayout {
                height: 24px;
                spacing: 8px;

                Image {
                    width: 15px;
                    height: 15px;
                    source: @image-url("icons/clock-3.svg");
                    colorize: #718099;
                }
                Text {
                    text: "RECENTLY ACCESSED";
                    color: #718099;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                    font-family: "Microsoft YaHei UI, Segoe UI, sans-serif";
                }
                Text {
                    text: root.results.length + (root.results.length == 1 ? " item" : " items");
                    color: #58667d;
                    font-size: 11px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    font-family: "Microsoft YaHei UI, Segoe UI, sans-serif";
                }
            }

            Rectangle {
                border-radius: 10px;
                background: #161c27;
                clip: true;

                if results.length == 0: Text {
                    text: root.status-text;
                    color: #8792a5;
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-family: "Microsoft YaHei UI, Segoe UI, sans-serif";
                }

                if results.length > 0: ScrollView {
                    VerticalLayout {
                        spacing: 2px;

                        for item[index] in root.results: Rectangle {
                            height: 62px;
                            background: index == root.selected-index ? #26385f : touch.has-hover ? #202a3a : transparent;
                            border-radius: 7px;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;

                                Rectangle {
                                    width: 34px;
                                    height: 34px;
                                    border-radius: 8px;
                                    background: item.kind == "Folder" ? #574b29 : #263d61;

                                    Image {
                                        x: 8px;
                                        y: 8px;
                                        width: 18px;
                                        height: 18px;
                                        source: item.kind == "Folder"
                                            ? @image-url("icons/folder.svg")
                                            : @image-url("icons/file.svg");
                                        colorize: item.kind == "Folder" ? #ffd36b : #8fb8ff;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    Text {
                                        text: item.name;
                                        color: #f1f5fb;
                                        font-size: 15px;
                                        overflow: elide;
                                        font-family: "Microsoft YaHei UI, Segoe UI, sans-serif";
                                    }
                                    Text {
                                        text: item.path;
                                        color: #8692a7;
                                        font-size: 12px;
                                        overflow: elide;
                                        font-family: "Microsoft YaHei UI, Segoe UI, sans-serif";
                                    }
                                }

                                Text {
                                    width: 74px;
                                    text: item.accessed;
                                    color: #6f7e94;
                                    font-size: 11px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    font-family: "Microsoft YaHei UI, Segoe UI, sans-serif";
                                }

                                Image {
                                    width: 15px;
                                    height: 15px;
                                    source: @image-url("icons/external-link.svg");
                                    colorize: index == root.selected-index ? #a9c3ff : #607089;
                                }
                            }

                            touch := TouchArea {
                                clicked => {
                                    root.selected-index = index;
                                    root.open-requested(index);
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: 22px;

                Text {
                    text: "↑↓ Select   Enter Open   Esc Hide   Ctrl+Q Quit";
                    color: #69768b;
                    font-size: 11px;
                    font-family: "Microsoft YaHei UI, Segoe UI, sans-serif";
                }
                Text {
                    text: "Alt + Shift + Space";
                    color: #69768b;
                    font-size: 11px;
                    horizontal-alignment: right;
                    font-family: "Microsoft YaHei UI, Segoe UI, sans-serif";
                }
            }
        }
    }
}
